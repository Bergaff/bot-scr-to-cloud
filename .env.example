# Ключи радара. Скопируй этот файл в .env и впиши свои значения (кавычки не нужны).
# Проще всего: start.bat --login (mac/Linux: ./start.sh --login) — мастер спросит ключи,
# создаст .env, впишет их сюда, покажет QR-код для входа и определит chat_id бота.
#
# api_id и api_hash — ключи ПРИЛОЖЕНИЯ (не пароль от аккаунта): по ним Telethon/Pyrogram
# говорят Telegram, какое приложение стучится. Получить бесплатно и один раз:
#   https://my.telegram.org/auth?to=apps  ->  название приложения любое  ->  App api_id / App api_hash
# Приложение регистрируй на свой аккаунт: чужие «готовые» ключи из интернета делят трафик
# со всеми, кто их использует, и аккаунт с них слетает заметно чаще.
# Значения ниже — примеры: api_id из 7 цифр, api_hash ровно 32 символа (0-9, a-f).
TG_API_ID=1234567
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Необязательно: уведомления сообщением от бота (@BotFather -> /newbot -> токен).
# chat_id мастер определит сам (попросит нажать «Старт» в боте); либо узнай его у @userinfobot.
TG_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_NOTIFY_CHAT=123456789

# Необязательно: имя файла сессии (для второго аккаунта — другое имя, например second_session)
TG_SESSION=monitor_session
