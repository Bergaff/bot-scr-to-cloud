# Шаблон секретов Worker'а — для загрузки ОДНОЙ командой вместо восьми.
#
#   1. скопируй этот файл в deploy/secrets.env
#   2. впиши свои значения вместо заглушек (кавычки не нужны)
#   3. загрузи:   npx wrangler secret bulk deploy/secrets.env
#   4. проверь:   npx wrangler secret list --format pretty
#   5. УДАЛИ deploy/secrets.env — значениям не место на диске и тем более в git
#
# deploy/secrets.env вписан и в .gitignore, и в .dockerignore (в git и в образ не уедет),
# но полагаться на это не стоит: удали файл сразу после загрузки — del deploy\secrets.env.
#
# ВАЖНО — сюда идут ТОЛЬКО секреты (8 штук). R2_BUCKET, TG_SESSION, RADAR_ARGS и
# RADAR_TIMEOUT заданы в wrangler.jsonc -> vars: одно и то же имя не может быть одновременно
# var и secret, деплой упадёт. Поэтому НЕ подсовывай wrangler'у общий .env проекта —
# в нём есть TG_SESSION, и он приедет как секрет вместо переменной.
#
# Запускать из папки проекта (там, где wrangler.jsonc): иначе wrangler не знает, какому
# Worker'у адресованы секреты, и просит --name.

# Ключи приложения: https://my.telegram.org/auth?to=apps  (название приложения — любое).
# Быстрее всего их добыть так: start.bat --login -> мастер спросит и положит в .env.
TG_API_ID=1234567
TG_API_HASH=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Бот: токен от @BotFather и твой числовой chat_id.
# chat_id мастер определит сам (start.bat --login -> шаг с ботом) либо @userinfobot.
TG_BOT_TOKEN=1234567890:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_NOTIFY_CHAT=123456789

# Доступ к R2: Account ID виден в дашборде (он же в адресе бакета),
# Access Key ID и Secret Access Key — из API-токена R2 (Object Read & Write на этот бакет).
# Secret Access Key показывается один раз.
R2_ACCOUNT_ID=00000000000000000000000000000000
R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Пароль к проверочным адресам Worker'а (/check, /run, /status, /usage, /log, /restart).
# ТОЛЬКО ASCII: Worker передаёт токен HTTP-заголовком, а заголовки живут в latin-1 —
# с кириллицей запросы до контейнера не дойдут.
# Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(24))"
RADAR_TOKEN=change-me-ascii-only
